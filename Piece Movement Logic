def move_piece(board, position, direction, piece_code, is_rook=False):
    x, y = position
    dx, dy = 0, 0
    if direction == "up": dx = -1
    elif direction == "down": dx = 1
    elif direction == "left": dy = -1
    elif direction == "right": dy = 1
    else: return position, None

    if is_rook:
        for step in range(1, 8):
            new_x, new_y = x + dx * step, y + dy * step
            if 0 <= new_x < 8 and 0 <= new_y < 8:
                target = board[new_x][new_y]
                if target == ".":
                    continue
                elif target[0] != piece_code[0]:
                    board[x][y] = "."
                    board[new_x][new_y] = piece_code
                    if target == "CK":
                        return [new_x, new_y], "win"
                    elif target == "PK":
                        return [new_x, new_y], "lose"
                    return [new_x, new_y], None
                else:
                    break
            else:
                break
        step -= 1
        final_x, final_y = x + dx * step, y + dy * step
        if 0 <= final_x < 8 and 0 <= final_y < 8 and board[final_x][final_y] == ".":
            board[x][y] = "."
            board[final_x][final_y] = piece_code
            return [final_x, final_y], None
        return position, None
    else:
        new_x, new_y = x + dx, y + dy
        if 0 <= new_x < 8 and 0 <= new_y < 8:
            target = board[new_x][new_y]
            if target == "." or target[0] != piece_code[0]:
                board[x][y] = "."
                board[new_x][new_y] = piece_code
                if target == "CK":
                    return [new_x, new_y], "win"
                elif target == "PK":
                    return [new_x, new_y], "lose"
                return [new_x, new_y], None
        return position, None
